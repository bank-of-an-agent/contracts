pragma solidity 0.8.30;

import {AgentAttestationRegistry} from "../../src/AgentAttestationRegistry.sol";
import {AgentClaimsVerifier} from "../../src/AgentClaimsVerifier.sol";
import {IAgentClaimsVerifier} from "../../src/interfaces/IAgentClaimsVerifier.sol";
import {AgentClaimsGroth16Verifier} from "../../src/verifiers/AgentClaimsGroth16Verifier.sol";
import {BaseTest} from "../utils/BaseTest.sol";
import {ClaimsFixtures} from "../utils/ClaimsFixtures.sol";

/// @notice AgentClaimsVerifier against real Groth16 proofs from the committed circuit artifacts
///         (test/fixtures/claims, regenerated by `npm run fixtures` in circuits/).
contract AgentClaimsVerifierTest is BaseTest, ClaimsFixtures {
    uint64 internal constant SNAPSHOT_AGE = 10 minutes;
    uint64 internal constant TTL = 2 hours;
    /// @dev Gas forwarded when a proof may be malformed (a valid proof needs well under half of it).
    uint256 internal constant GAS_BOUND = 1_000_000;

    AgentAttestationRegistry internal registry;
    AgentClaimsGroth16Verifier internal groth16;
    AgentClaimsVerifier internal verifier;
    address internal admin = makeAddr("registry-admin");
    address internal attester = makeAddr("attester");

    Fixture internal unconstrained;
    Fixture internal company;
    Fixture internal reservation;
    uint64 internal snapshotAt;
    uint64 internal validUntil;

    function setUp() public override {
        super.setUp();
        unconstrained = _fixture("unconstrained");
        company = _fixture("verified_company");
        reservation = _fixture("reservation");
        vm.chainId(company.chainId);

        registry = new AgentAttestationRegistry(admin, attester);
        groth16 = new AgentClaimsGroth16Verifier();
        verifier = new AgentClaimsVerifier(address(registry), address(groth16));

        snapshotAt = uint64(block.timestamp) - SNAPSHOT_AGE;
        validUntil = uint64(block.timestamp) + TTL;
        vm.prank(attester);
        registry.publishRoot(company.claims.root, 1, snapshotAt, validUntil, company.leafCount);
    }

    // ------------------------------------------------------------------ helpers

    function _verify(Fixture memory f) internal view returns (bool) {
        return verifier.verify(f.claims, f.proof, f.leafCount, 0);
    }

    function _consume(Fixture memory f) internal returns (uint256) {
        vm.prank(f.consumer);
        return verifier.verifyAndConsume(f.context, f.claims, f.proof, f.leafCount, 0);
    }

    function _revoke(bytes32 root) internal {
        bytes32[] memory roots = new bytes32[](1);
        roots[0] = root;
        vm.prank(attester);
        registry.revokeRoots(roots);
    }

    function _all() internal view returns (Fixture[3] memory) {
        return [unconstrained, company, reservation];
    }

    // ------------------------------------------------------------------ construction and fixtures

    /// @dev Deploys through an external call: with dynamic test linking, `vm.expectRevert` + `new` ends the test at
    ///      the first expected revert, silently skipping the rest.
    function deployVerifier(address registry_, address groth16_) external returns (AgentClaimsVerifier) {
        return new AgentClaimsVerifier(registry_, groth16_);
    }

    function test_constructor() public {
        assertEq(verifier.registry(), address(registry));
        assertEq(verifier.groth16Verifier(), address(groth16));
        assertEq(verifier.ATTRIBUTE_COUNT(), 13);
        vm.expectRevert(AgentClaimsVerifier.ZeroAddress.selector);
        this.deployVerifier(address(0), address(groth16));
        vm.expectRevert(AgentClaimsVerifier.ZeroAddress.selector);
        this.deployVerifier(address(registry), address(0));
        assertEq(this.deployVerifier(address(registry), address(groth16)).registry(), address(registry));
    }

    /// @notice The fixtures share one tree and one scope; the claims struct maps onto the circuit's public signals in
    ///         snarkjs order, and the generated verifier accepts them directly.
    function test_fixtures_matchCircuitSignalOrder() public view {
        Fixture[3] memory all = _all();
        for (uint256 k; k < all.length; ++k) {
            Fixture memory f = all[k];
            assertEq(f.claims.root, company.claims.root, f.name);
            assertEq(f.leafCount, 5, f.name);
            assertEq(f.claims.scope, verifier.scopeOf(f.consumer, f.context), f.name);
            uint256[30] memory s = _signals(f.claims);
            for (uint256 i; i < 30; ++i) {
                assertEq(s[i], f.publicSignals[i], f.name);
            }
            assertTrue(groth16.verifyProof(f.proof.a, f.proof.b, f.proof.c, s), f.name);
        }
        // What the statements say.
        assertEq(company.claims.mins[0], 2, "verified company: principal_verification in [2, 2]");
        assertEq(company.claims.maxs[0], 2);
        assertEq(company.claims.mins[1], 5_000_000, "can pay 5.00 per transaction");
        assertEq(reservation.claims.mins[6], uint64(reservation.claims.scope), "reserved_for = scope mod 2^64");
        assertEq(reservation.claims.maxs[6], uint64(reservation.claims.scope));
        for (uint256 i; i < 13; ++i) {
            assertEq(unconstrained.claims.mins[i], 0);
            assertEq(unconstrained.claims.maxs[i], MAX64);
        }
        assertTrue(company.claims.nullifier != reservation.claims.nullifier, "different agents");
    }

    // ------------------------------------------------------------------ verify: accept

    function test_verify_acceptsEveryFixture() public view {
        Fixture[3] memory all = _all();
        for (uint256 k; k < all.length; ++k) {
            assertTrue(verifier.verify(all[k].claims, all[k].proof, 0, 0), all[k].name);
            assertTrue(verifier.verify(all[k].claims, all[k].proof, 5, SNAPSHOT_AGE), all[k].name);
        }
    }

    function test_verify_isStatelessAndRepeatable() public {
        assertTrue(_verify(company));
        _consume(company);
        assertTrue(_verify(company), "verify does not consume: callers check their own nonces");
    }

    // ------------------------------------------------------------------ verify: reject

    function test_verify_rejectsTamperedSignals() public view {
        IAgentClaimsVerifier.Claims memory c;
        c = company.claims;
        c.nullifier = (c.nullifier + 1) % SNARK_SCALAR_FIELD;
        assertFalse(verifier.verify(c, company.proof, 0, 0), "nullifier");
        c = company.claims;
        c.scope = (c.scope + 1) % SNARK_SCALAR_FIELD;
        assertFalse(verifier.verify(c, company.proof, 0, 0), "scope");
        c = company.claims;
        c.nonce = c.nonce + 1;
        assertFalse(verifier.verify(c, company.proof, 0, 0), "nonce");
        for (uint256 i; i < 13; ++i) {
            c = company.claims;
            c.mins[i] ^= 1;
            assertFalse(verifier.verify(c, company.proof, 0, 0), "min");
            c = company.claims;
            c.maxs[i] ^= 1;
            assertFalse(verifier.verify(c, company.proof, 0, 0), "max");
        }
        // Another fixture's statement with this proof.
        assertFalse(verifier.verify(reservation.claims, company.proof, 0, 0), "proof for another statement");
    }

    /// @notice The proof is bound to its root even when the other root is published and valid.
    function test_verify_rejectsProofAgainstAnotherValidRoot() public {
        bytes32 other = bytes32(uint256(company.claims.root) + 1);
        vm.prank(attester);
        registry.publishRoot(other, 2, snapshotAt, validUntil, 1000);
        IAgentClaimsVerifier.Claims memory c = company.claims;
        c.root = other;
        assertFalse(verifier.verify(c, company.proof, 0, 0));
        vm.prank(company.consumer);
        vm.expectRevert(IAgentClaimsVerifier.InvalidProof.selector);
        verifier.verifyAndConsume(company.context, c, company.proof, 0, 0);
    }

    /// @dev Points off the curve make the pairing precompile consume all gas forwarded to it, so each malformed proof
    ///      is checked with a bounded call, the way a relayer of untrusted proofs should call.
    function test_verify_rejectsTamperedProof() public view {
        for (uint256 i; i < 8; ++i) {
            IAgentClaimsVerifier.Groth16Proof memory p = _tamperProof(company.proof, i, 1);
            assertFalse(verifier.verify{gas: GAS_BOUND}(company.claims, p, 0, 0), vm.toString(i));
        }
        // snarkjs' native b order (pairs not swapped) is not the verifier's calldata order.
        IAgentClaimsVerifier.Groth16Proof memory native = company.proof;
        native.b = [[company.proof.b[0][1], company.proof.b[0][0]], [company.proof.b[1][1], company.proof.b[1][0]]];
        assertFalse(verifier.verify{gas: GAS_BOUND}(company.claims, native, 0, 0), "unswapped b");
        // Valid curve points that are not a proof: the points at infinity, and A and C swapped.
        IAgentClaimsVerifier.Groth16Proof memory zero;
        assertFalse(verifier.verify(company.claims, zero, 0, 0), "zero proof");
        IAgentClaimsVerifier.Groth16Proof memory swapped = company.proof;
        (swapped.a, swapped.c) = (company.proof.c, company.proof.a);
        assertFalse(verifier.verify(company.claims, swapped, 0, 0), "A and C swapped");
    }

    /// @notice A malformed proof burns at most the gas the caller forwards, then returns false; the caller keeps the
    ///         1/64 remainder and the rest of its own gas. A valid proof fits comfortably within the same bound.
    function test_verify_malformedProofCostIsBoundedByTheCaller() public view {
        IAgentClaimsVerifier.Groth16Proof memory bad = _tamperProof(company.proof, 0, 1);
        uint256 before = gasleft();
        assertFalse(verifier.verify{gas: GAS_BOUND}(company.claims, bad, 0, 0));
        assertLe(before - gasleft(), GAS_BOUND + GAS_BOUND / 20); // + call overhead (and coverage instrumentation)
        assertTrue(verifier.verify{gas: GAS_BOUND}(company.claims, company.proof, 0, 0));
    }

    function test_verify_rootNotValid() public {
        AgentAttestationRegistry empty = new AgentAttestationRegistry(admin, attester);
        AgentClaimsVerifier other = new AgentClaimsVerifier(address(empty), address(groth16));
        assertFalse(other.verify(company.claims, company.proof, 0, 0), "unpublished");

        vm.warp(validUntil);
        assertTrue(_verify(company), "valid through validUntil");
        vm.warp(validUntil + 1);
        assertFalse(_verify(company), "expired");

        vm.warp(validUntil - 1);
        _revoke(company.claims.root);
        assertFalse(_verify(company), "revoked");
    }

    function test_verify_rootTooOld() public {
        assertTrue(verifier.verify(company.claims, company.proof, 0, SNAPSHOT_AGE), "age == maxRootAge");
        assertFalse(verifier.verify(company.claims, company.proof, 0, SNAPSHOT_AGE - 1), "age > maxRootAge");
        vm.warp(block.timestamp + 1 hours);
        assertFalse(verifier.verify(company.claims, company.proof, 0, 1 hours), "older now");
        assertTrue(verifier.verify(company.claims, company.proof, 0, 0), "0 disables the age check");
    }

    function test_verify_anonymitySet() public view {
        assertTrue(verifier.verify(company.claims, company.proof, 0, 0));
        assertTrue(verifier.verify(company.claims, company.proof, company.leafCount, 0));
        assertFalse(verifier.verify(company.claims, company.proof, company.leafCount + 1, 0));
        assertFalse(verifier.verify(company.claims, company.proof, type(uint32).max, 0));
    }

    /// @notice x and x + r are the same field element; only the canonical one is accepted.
    function test_verify_fieldElementOutOfRange() public view {
        IAgentClaimsVerifier.Claims memory c = company.claims;
        c.nullifier += SNARK_SCALAR_FIELD;
        assertFalse(verifier.verify(c, company.proof, 0, 0), "nullifier");
        c = company.claims;
        c.scope += SNARK_SCALAR_FIELD;
        assertFalse(verifier.verify(c, company.proof, 0, 0), "scope");
        c = company.claims;
        c.nonce += SNARK_SCALAR_FIELD;
        assertFalse(verifier.verify(c, company.proof, 0, 0), "nonce");
    }

    // ------------------------------------------------------------------ verifyAndConsume

    function test_verifyAndConsume_acceptsOnceAndEmits() public {
        IAgentClaimsVerifier.Claims memory c = company.claims;
        assertFalse(verifier.nonceUsed(c.scope, c.nonce));
        vm.expectEmit(true, true, true, true, address(verifier));
        emit IAgentClaimsVerifier.ClaimsAccepted(company.consumer, c.scope, c.nullifier, c.root, c.nonce);
        assertEq(_consume(company), c.nullifier);
        assertTrue(verifier.nonceUsed(c.scope, c.nonce));

        vm.prank(company.consumer);
        vm.expectRevert(abi.encodeWithSelector(IAgentClaimsVerifier.NonceAlreadyUsed.selector, c.scope, c.nonce));
        verifier.verifyAndConsume(company.context, c, company.proof, 0, 0);

        // Other nonces in the same scope are independent.
        assertEq(_consume(unconstrained), unconstrained.claims.nullifier);
        assertEq(_consume(reservation), reservation.claims.nullifier);
    }

    function test_verifyAndConsume_scopeMismatch() public {
        IAgentClaimsVerifier.Claims memory c = company.claims;
        // Another consumer replaying the proof.
        uint256 strangers = verifier.scopeOf(stranger, company.context);
        vm.prank(stranger);
        vm.expectRevert(abi.encodeWithSelector(IAgentClaimsVerifier.ScopeMismatch.selector, strangers, c.scope));
        verifier.verifyAndConsume(company.context, c, company.proof, 0, 0);
        // The same consumer under another context.
        bytes32 otherContext = keccak256("another context");
        uint256 otherScope = verifier.scopeOf(company.consumer, otherContext);
        vm.prank(company.consumer);
        vm.expectRevert(abi.encodeWithSelector(IAgentClaimsVerifier.ScopeMismatch.selector, otherScope, c.scope));
        verifier.verifyAndConsume(otherContext, c, company.proof, 0, 0);
        // The same consumer and context on another chain.
        vm.chainId(31_337);
        uint256 local = verifier.scopeOf(company.consumer, company.context);
        vm.prank(company.consumer);
        vm.expectRevert(abi.encodeWithSelector(IAgentClaimsVerifier.ScopeMismatch.selector, local, c.scope));
        verifier.verifyAndConsume(company.context, c, company.proof, 0, 0);
    }

    function test_verifyAndConsume_rootNotValid() public {
        IAgentClaimsVerifier.Claims memory c = company.claims;
        c.root = bytes32(uint256(c.root) + 1);
        vm.prank(company.consumer);
        vm.expectRevert(abi.encodeWithSelector(IAgentClaimsVerifier.RootNotValid.selector, c.root));
        verifier.verifyAndConsume(company.context, c, company.proof, 0, 0);

        vm.warp(validUntil + 1);
        vm.prank(company.consumer);
        vm.expectRevert(abi.encodeWithSelector(IAgentClaimsVerifier.RootNotValid.selector, company.claims.root));
        verifier.verifyAndConsume(company.context, company.claims, company.proof, 0, 0);

        vm.warp(validUntil);
        _revoke(company.claims.root);
        vm.prank(company.consumer);
        vm.expectRevert(abi.encodeWithSelector(IAgentClaimsVerifier.RootNotValid.selector, company.claims.root));
        verifier.verifyAndConsume(company.context, company.claims, company.proof, 0, 0);
    }

    function test_verifyAndConsume_rootTooOld() public {
        uint64 maxAge = SNAPSHOT_AGE - 1;
        vm.prank(company.consumer);
        vm.expectRevert(
            abi.encodeWithSelector(IAgentClaimsVerifier.RootTooOld.selector, company.claims.root, snapshotAt, maxAge)
        );
        verifier.verifyAndConsume(company.context, company.claims, company.proof, 0, maxAge);
    }

    function test_verifyAndConsume_anonymitySetTooSmall() public {
        uint32 min = company.leafCount + 1;
        vm.prank(company.consumer);
        vm.expectRevert(
            abi.encodeWithSelector(
                IAgentClaimsVerifier.AnonymitySetTooSmall.selector, company.claims.root, company.leafCount, min
            )
        );
        verifier.verifyAndConsume(company.context, company.claims, company.proof, min, 0);
    }

    function test_verifyAndConsume_fieldElementOutOfRange() public {
        IAgentClaimsVerifier.Claims memory c = company.claims;
        c.nonce += SNARK_SCALAR_FIELD;
        vm.prank(company.consumer);
        vm.expectRevert(IAgentClaimsVerifier.FieldElementOutOfRange.selector);
        verifier.verifyAndConsume(company.context, c, company.proof, 0, 0);

        c = company.claims;
        c.nullifier += SNARK_SCALAR_FIELD;
        vm.prank(company.consumer);
        vm.expectRevert(IAgentClaimsVerifier.FieldElementOutOfRange.selector);
        verifier.verifyAndConsume(company.context, c, company.proof, 0, 0);
    }

    function test_verifyAndConsume_invalidProofConsumesNothing() public {
        vm.prank(company.consumer);
        vm.expectRevert(IAgentClaimsVerifier.InvalidProof.selector);
        verifier.verifyAndConsume{gas: GAS_BOUND}(
            company.context, company.claims, _tamperProof(company.proof, 3, 1), 0, 0
        );

        IAgentClaimsVerifier.Claims memory c = company.claims;
        c.mins[1] = 4_000_000; // a weaker statement than the one proven
        vm.prank(company.consumer);
        vm.expectRevert(IAgentClaimsVerifier.InvalidProof.selector);
        verifier.verifyAndConsume(company.context, c, company.proof, 0, 0);

        assertFalse(verifier.nonceUsed(company.claims.scope, company.claims.nonce));
        assertEq(_consume(company), company.claims.nullifier);
    }

    // ------------------------------------------------------------------ scopeOf

    function test_scopeOf_matchesDefinitionAndDiffers() public {
        address consumer = company.consumer;
        bytes32 context = company.context;
        uint256 s = verifier.scopeOf(consumer, context);
        assertEq(
            s,
            uint256(keccak256(abi.encode("agentbank.proofs.scope.v1", block.chainid, consumer, context)))
                % SNARK_SCALAR_FIELD
        );
        assertEq(s, company.claims.scope, "matches the circuit fixtures' JS derivation");
        assertTrue(verifier.scopeOf(stranger, context) != s, "consumer");
        assertTrue(verifier.scopeOf(consumer, bytes32(uint256(context) ^ 1)) != s, "context");
        vm.chainId(31_337);
        assertTrue(verifier.scopeOf(consumer, context) != s, "chain id");
    }

    // ------------------------------------------------------------------ fuzz

    /// @notice Changing any one public signal to any other field element (with the root re-published so only the
    ///         pairing check can reject it) never verifies.
    function testFuzz_verify_tamperedSignalNeverVerifies(uint256 index, uint256 delta) public {
        index = bound(index, 0, 29);
        IAgentClaimsVerifier.Claims memory c = company.claims;
        if (index < 4) {
            uint256 d = 1 + delta % (SNARK_SCALAR_FIELD - 1); // never 0 mod r
            if (index == 0) c.nullifier = addmod(c.nullifier, d, SNARK_SCALAR_FIELD);
            if (index == 1) c.root = bytes32(addmod(uint256(c.root), d, SNARK_SCALAR_FIELD));
            if (index == 2) c.scope = addmod(c.scope, d, SNARK_SCALAR_FIELD);
            if (index == 3) c.nonce = addmod(c.nonce, d, SNARK_SCALAR_FIELD);
        } else {
            uint64 d = uint64(1 + delta % (uint256(MAX64))); // never 0 mod 2^64
            unchecked {
                if (index < 17) c.mins[index - 4] += d;
                else c.maxs[index - 17] += d;
            }
        }
        if (c.root != company.claims.root && c.root != bytes32(0)) {
            vm.prank(attester);
            registry.publishRoot(c.root, 2, snapshotAt, validUntil, 1000);
        }
        assertFalse(verifier.verify(c, company.proof, 0, 0));
    }

    /// @notice Replacing any proof coordinate with any other value never verifies (and never reverts).
    function testFuzz_verify_tamperedProofNeverVerifies(uint256 coordinate, uint256 value) public view {
        coordinate = bound(coordinate, 0, 7);
        vm.assume(value != _coordinate(company.proof, coordinate));
        IAgentClaimsVerifier.Groth16Proof memory p = _setCoordinate(company.proof, coordinate, value);
        assertFalse(verifier.verify{gas: GAS_BOUND}(company.claims, p, 0, 0));
    }

    /// @notice Any caller other than the consumer the proof was made for is refused, whatever the context.
    function testFuzz_verifyAndConsume_onlyTheScopedConsumer(address caller, bytes32 context) public {
        vm.assume(caller != company.consumer || context != company.context);
        uint256 expected = verifier.scopeOf(caller, context);
        vm.prank(caller);
        vm.expectRevert(
            abi.encodeWithSelector(IAgentClaimsVerifier.ScopeMismatch.selector, expected, company.claims.scope)
        );
        verifier.verifyAndConsume(context, company.claims, company.proof, 0, 0);
    }

    /// @notice Scopes are always field elements and follow the documented derivation.
    function testFuzz_scopeOf(uint64 chainId, address consumer, bytes32 context) public {
        vm.chainId(chainId);
        uint256 s = verifier.scopeOf(consumer, context);
        assertLt(s, SNARK_SCALAR_FIELD);
        assertEq(
            s,
            uint256(keccak256(abi.encode("agentbank.proofs.scope.v1", chainId, consumer, context))) % SNARK_SCALAR_FIELD
        );
    }

    // ------------------------------------------------------------------ proof helpers

    function _coordinate(IAgentClaimsVerifier.Groth16Proof memory p, uint256 i) internal pure returns (uint256) {
        if (i < 2) return p.a[i];
        if (i < 6) return p.b[(i - 2) / 2][(i - 2) % 2];
        return p.c[i - 6];
    }

    function _setCoordinate(IAgentClaimsVerifier.Groth16Proof memory p, uint256 i, uint256 value)
        internal
        pure
        returns (IAgentClaimsVerifier.Groth16Proof memory out)
    {
        out.a = [p.a[0], p.a[1]];
        out.b = [[p.b[0][0], p.b[0][1]], [p.b[1][0], p.b[1][1]]];
        out.c = [p.c[0], p.c[1]];
        if (i < 2) out.a[i] = value;
        else if (i < 6) out.b[(i - 2) / 2][(i - 2) % 2] = value;
        else out.c[i - 6] = value;
    }

    function _tamperProof(IAgentClaimsVerifier.Groth16Proof memory p, uint256 i, uint256 delta)
        internal
        pure
        returns (IAgentClaimsVerifier.Groth16Proof memory)
    {
        return _setCoordinate(p, i, _coordinate(p, i) + delta);
    }
}
